# Copy to .env (repo root for docker compose, or export in your shell). Placeholders only.
# Port the server listens on (0.0.0.0:PORT). ADDR overrides it, for example ADDR=0.0.0.0:9000
PORT=8080
# Long random string used to sign access tokens. Generate with: openssl rand -hex 32
APP_SECRET=replace-with-a-long-random-string
# Comma separated list of frontend origins allowed by CORS. Use * only for demos.
ALLOWED_ORIGIN=http://localhost:5173
# Fixed sign in code for the demo. Demo only, there is no real SMS.
DEV_OTP=123456
# Only "mock" exists. The server refuses to start with PROVIDER=real.
PROVIDER=mock
# true when running behind a reverse proxy or load balancer (uses X-Forwarded-For)
TRUST_PROXY=false
# Shown in GET /api/health
VERSION=0.1.0
